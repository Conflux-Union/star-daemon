{
  "name": "star-system-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test src/journey.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "test:spatial": "node scripts/spatial-check.mjs",
    "format": "prettier --write src scripts index.html vite.config.ts tsconfig.json package.json README.md",
    "format:check": "prettier --check src scripts index.html vite.config.ts tsconfig.json package.json README.md"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.0",
    "playwright": "^1.58.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  }
}
